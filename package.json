{
  "name": "gateway-config",
  "version": "0.3.0",
  "description": "DSH plugin for configuring any OpenAI-compatible LLM gateway (GET /models discovery) as a provider",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": { "default": "./lib/index.js" },
    "./client": { "default": "./lib/client.js" },
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": ["@deepseek-ai/dsh-client-runtime", "@deepseek-ai/dsh-client-connection"],
      "platform": "web"
    }
  },
  "engines": { "node": ">=20" },
  "peerDependencies": {
    "@deepseek-ai/dsh-client-connection": "0.1.1-rc.1",
    "@deepseek-ai/dsh-credentials": "0.1.1-rc.1",
    "@deepseek-ai/dsh-tools": "0.1.1-rc.1",
    "@earendil-works/pi-ai": "^0.82.1"
  },
  "license": "MIT"
}
